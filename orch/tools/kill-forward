#!/usr/bin/env python3
"""kill-forward [<pid>... | --list]

Stops an agent's leftover ``kubectl port-forward`` processes: a local
forwarding process whose loss is undone by starting it again. Every PID is
checked before any signal is sent: it must belong to the current uid and its
command line must be a kubectl port-forward (gate_policy.forward_refusal).
One refusal kills nothing and exits 2 with one line per refused PID; otherwise
each PID gets SIGTERM. Without arguments, or with --list, prints the current
user's kubectl port-forward processes (pid, ppid, elapsed, command).
"""

import os
import signal
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import gate_policy  # noqa: E402


def processes():
    """{pid: (uid, ppid, elapsed, args)} for every process ``ps`` shows."""
    out = subprocess.run(["ps", "-A", "-o", "pid=,uid=,ppid=,etime=,args="],
                         capture_output=True, text=True, check=True).stdout
    rows = {}
    for line in out.splitlines():
        fields = line.split(None, 4)
        if len(fields) == 5:
            pid, uid, ppid, etime, args = fields
            rows[pid] = (int(uid), ppid, etime, args)
    return rows


def main(argv):
    rows = processes()
    uid = os.getuid()
    if not argv or argv == ["--list"]:
        for pid, (owner, ppid, etime, args) in sorted(rows.items(), key=lambda r: int(r[0])):
            if gate_policy.forward_refusal(pid, rows.get(pid), uid) is None:
                print("%s\t%s\t%s\t%s" % (pid, ppid, etime, args))
        return 0
    refusals = [why for why in (gate_policy.forward_refusal(p, rows.get(p), uid) for p in argv) if why]
    if refusals:
        for r in refusals:
            print("kill-forward: refused " + r, file=sys.stderr)
        return 2
    for p in argv:
        os.kill(int(p), signal.SIGTERM)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
