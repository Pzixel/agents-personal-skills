#!/usr/bin/env python3
"""Launcher of tmp_evict.main (the module is importable so that its scan workers can be spawned)."""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

import tmp_evict  # noqa: E402

if __name__ == "__main__":
    sys.exit(tmp_evict.main())
