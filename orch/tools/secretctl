#!/usr/bin/env python3
"""secretctl: use secret values without ever printing them.

The vault is `$SECRET_VAULT_DIR` or `~/.secrets` (dir 0700, files 0600). Vault
files are named relatively, without the `.txt` suffix: `acme/service_keys`.
Commands never take or print a value; every output line passes through the
same redaction as the Bash PostToolUse hook, and `run`/`each` always exit 0 so a
failing child command still returns through the redacted (success) path.

  secretctl list NAME                       labels, lengths, digests
  secretctl import NAME --from TABLE [--force]
                                            rows "<label words...> <value>" -> vault file
  secretctl pull-k8s NAME -n NS SECRET KEY [--force]
                                            Secret data[KEY] -> vault file, nothing printed
  secretctl merge BASE UPDATES -o OUT [--replace "OLD=NEW"]... [--force]
                                            values by label; renames keep position
  secretctl apply-k8s NAME -n NS SECRET KEY --confirm
                                            vault file -> Secret data[KEY] (kubectl apply)
  secretctl run NAME LABEL [--env VAR] -- CMD [ARGS...]
                                            CMD with $SECRET_VALUE / $SECRET_LABEL expanded
                                            in its arguments and exported in its environment
  secretctl each NAME [--env VAR] -- CMD [ARGS...]
                                            `run` for every label in the file
  secretctl capture NAME [--stdin FILE] [--table] [--force] -- CMD [ARGS...]
                                            CMD's stdout -> vault file; only stderr and exit shown

`--env VAR` additionally exports the value as VAR (e.g. EXAMPLEVENDOR_API_KEY).
"""

import argparse
import base64
import json
import os
import subprocess
import sys

TOOLS_DIR = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, TOOLS_DIR)

import gate_policy  # noqa: E402
import vault_files  # noqa: E402
import vault_policy  # noqa: E402

VAULT_DIR = vault_files.VAULT_DIR


def _tokens():
    texts, _protected = vault_files.load_vault(VAULT_DIR)
    return vault_policy.vault_tokens(texts)


def _say(text, tokens):
    sys.stdout.write(gate_policy.redact_secrets(text, tokens))
    if not text.endswith("\n"):
        sys.stdout.write("\n")
    sys.stdout.flush()


def _read_vault(name):
    path = vault_files.vault_file_path(VAULT_DIR, name)
    with open(path, encoding="utf-8") as handle:
        return handle.read()


def _write_vault(name, text, force):
    path = vault_files.vault_file_path(VAULT_DIR, name)
    if os.path.exists(path) and not force:
        raise SystemExit("secretctl: %s exists; pass --force to replace it" % name)
    vault_files.write_vault_file(path, text)
    return path


def _print_entries(text, tokens):
    rows = vault_policy.summary_rows(vault_policy.parse_entries(text))
    _say("%d entries" % len(rows), tokens)
    for label, length, digest in rows:
        _say("  %-40s len=%d sha8=%s" % (label, length, digest), tokens)


def cmd_list(args):
    _print_entries(_read_vault(args.name), _tokens())


def cmd_import(args):
    with open(args.source, encoding="utf-8") as handle:
        text = vault_policy.import_table(handle.read())
    if not text:
        raise SystemExit("secretctl: no rows with a value in %s" % args.source)
    _write_vault(args.name, text, args.force)
    _print_entries(text, _tokens())


def _kubectl(argv, stdin_text=None):
    result = subprocess.run(
        ["kubectl"] + argv, input=stdin_text, capture_output=True, text=True, check=False
    )
    return result.returncode, result.stdout, result.stderr


def cmd_pull_k8s(args):
    rc, out, err = _kubectl(["-n", args.namespace, "get", "secret", args.secret, "-o", "json"])
    if rc != 0:
        raise SystemExit("secretctl: kubectl get failed: %s" % err.strip()[:300])
    data = json.loads(out).get("data") or {}
    if args.key not in data:
        raise SystemExit("secretctl: key %s not in Secret %s (keys: %s)" % (
            args.key, args.secret, ", ".join(sorted(data))))
    text = base64.b64decode(data[args.key]).decode("utf-8")
    _write_vault(args.name, text, args.force)
    _print_entries(text, _tokens())


def cmd_merge(args):
    renames = {}
    for item in args.replace or []:
        if "=" not in item:
            raise SystemExit("secretctl: --replace expects OLD=NEW")
        old, new = item.split("=", 1)
        renames[old.strip()] = new.strip()
    text, rows = vault_policy.merge(_read_vault(args.base), _read_vault(args.updates), renames)
    _write_vault(args.out, text, args.force)
    tokens = _tokens()
    for label, status, old, new in rows:
        _say("  %-9s %-40s %s -> %s" % (status, label, old or "-", new), tokens)


def cmd_apply_k8s(args):
    if not args.confirm:
        raise SystemExit("secretctl: apply-k8s changes a live Secret; pass --confirm")
    text = _read_vault(args.name)
    manifest = json.dumps({
        "apiVersion": "v1",
        "kind": "Secret",
        "metadata": {"name": args.secret, "namespace": args.namespace},
        "type": "Opaque",
        "data": {args.key: base64.b64encode(text.encode("utf-8")).decode("ascii")},
    })
    rc, out, err = _kubectl(["apply", "-f", "-"], stdin_text=manifest)
    tokens = _tokens()
    _say(out + err, tokens)
    _say("exit=%d" % rc, tokens)
    sys.exit(0 if rc == 0 else 1)


def _expand(arg, value, label):
    for var, replacement in (("SECRET_VALUE", value), ("SECRET_LABEL", label)):
        arg = arg.replace("${%s}" % var, replacement).replace("$%s" % var, replacement)
    return arg


def _run_one(label, value, command, env_name, tokens):
    env = dict(os.environ, SECRET_VALUE=value, SECRET_LABEL=label)
    if env_name:
        env[env_name] = value
    argv = [_expand(arg, value, label) for arg in command]
    try:
        result = subprocess.run(argv, env=env, capture_output=True, text=True, check=False)
        output = result.stdout + result.stderr
        rc = result.returncode
    except OSError as error:
        output = "secretctl: cannot run command: %s" % error
        rc = 127
    _say(output, tokens)
    _say("exit=%d" % rc, tokens)
    return rc


def cmd_run(args):
    entries = dict(vault_policy.parse_entries(_read_vault(args.name)))
    if args.label not in entries:
        raise SystemExit("secretctl: no label %r in %s (labels: %s)" % (
            args.label, args.name, "; ".join(entries)))
    _run_one(args.label, entries[args.label], args.command, args.env, _tokens())


def cmd_each(args):
    tokens = _tokens()
    for label, value in vault_policy.parse_entries(_read_vault(args.name)):
        _say("== %s" % label, tokens)
        _run_one(label, value, args.command, args.env, tokens)


def cmd_capture(args):
    """Store CMD's stdout as a vault file; only its stderr and exit code are shown."""
    stdin_text = None
    if args.stdin:
        with open(args.stdin, encoding="utf-8") as handle:
            stdin_text = handle.read()
    try:
        result = subprocess.run(args.command, input=stdin_text, capture_output=True, text=True, check=False)
    except OSError as error:
        raise SystemExit("secretctl: cannot run command: %s" % error)
    tokens = _tokens()
    _say(result.stderr, tokens)
    _say("exit=%d" % result.returncode, tokens)
    if result.returncode != 0:
        raise SystemExit("secretctl: command failed; nothing stored")
    text = vault_policy.import_table(result.stdout) if args.table else result.stdout
    if not vault_policy.parse_entries(text):
        raise SystemExit("secretctl: command produced no label/value entries; nothing stored")
    _write_vault(args.name, text, args.force)
    _print_entries(text, _tokens())


def _split_command(argv):
    if "--" not in argv:
        raise SystemExit("secretctl: put the command after `--`")
    index = argv.index("--")
    return argv[:index], argv[index + 1:]


def main(argv):
    parser = argparse.ArgumentParser(prog="secretctl", description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("list"); p.add_argument("name"); p.set_defaults(fn=cmd_list)

    p = sub.add_parser("import"); p.add_argument("name"); p.add_argument("--from", dest="source", required=True)
    p.add_argument("--force", action="store_true"); p.set_defaults(fn=cmd_import)

    p = sub.add_parser("pull-k8s"); p.add_argument("name"); p.add_argument("-n", "--namespace", required=True)
    p.add_argument("secret"); p.add_argument("key"); p.add_argument("--force", action="store_true")
    p.set_defaults(fn=cmd_pull_k8s)

    p = sub.add_parser("merge"); p.add_argument("base"); p.add_argument("updates")
    p.add_argument("-o", "--out", required=True); p.add_argument("--replace", action="append")
    p.add_argument("--force", action="store_true"); p.set_defaults(fn=cmd_merge)

    p = sub.add_parser("apply-k8s"); p.add_argument("name"); p.add_argument("-n", "--namespace", required=True)
    p.add_argument("secret"); p.add_argument("key"); p.add_argument("--confirm", action="store_true")
    p.set_defaults(fn=cmd_apply_k8s)

    p = sub.add_parser("run"); p.add_argument("name"); p.add_argument("label"); p.add_argument("--env")
    p.set_defaults(fn=cmd_run)

    p = sub.add_parser("each"); p.add_argument("name"); p.add_argument("--env"); p.set_defaults(fn=cmd_each)

    p = sub.add_parser("capture"); p.add_argument("name"); p.add_argument("--stdin")
    p.add_argument("--table", action="store_true", help="stdout rows are '<label words...> <value>'")
    p.add_argument("--force", action="store_true"); p.set_defaults(fn=cmd_capture)

    command = []
    if argv and argv[0] in ("run", "each", "capture"):
        argv, command = _split_command(argv)
        if not command:
            raise SystemExit("secretctl: empty command after `--`")
    args = parser.parse_args(argv)
    args.command = command
    args.fn(args)


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except SystemExit:
        raise
    except Exception as error:  # never echo a value through a traceback
        sys.stderr.write(gate_policy.redact_secrets("secretctl: %s\n" % error, _tokens()))
        sys.exit(1)
