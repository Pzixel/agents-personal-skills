#!/usr/bin/env python3
"""Print one line per skill or agent name the model sees from two sources.

Reads the config dir of the running session ($CLAUDE_CONFIG_DIR or ~/.claude).
No output when there is no duplicate; exit 0 either way. install.sh fails on
any output.
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import dup_policy  # noqa: E402

for line in dup_policy.duplicates(dup_policy.scan(dup_policy.config_dir())):
    print(line)
