#!/usr/bin/env python3
"""rm-own [-r] <path>...

Removes project-owned scratch paths only. The shell has already expanded
variables, cd and globs. Each operand is taken physically: its parent
directory is resolved through symlinks before any ``..`` applies, the final
component is the object itself (a symlink is removed, never followed). That
real path is accepted only when the destructive gate's ours rule holds on it
(gate_policy.own_removal), and it is what gets removed. Every operand is
checked before anything is removed; one refusal removes nothing and exits 2
with one line per refused path. Directories need -r.
"""

import os
import shutil
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import gate_policy  # noqa: E402


def main(argv):
    recursive = bool(argv) and argv[0] == "-r"
    paths = argv[1:] if recursive else argv
    if not paths:
        print("usage: rm-own [-r] <path>...", file=sys.stderr)
        return 2
    params = gate_policy.load_params()
    checked = [gate_policy.own_removal(p, params) for p in paths]
    refusals = [why for _, why in checked if why]
    for p, (real, _) in zip(paths, checked):
        if real and os.path.isdir(real) and not os.path.islink(real) and not recursive:
            refusals.append(p + ": is a directory (use -r)")
    if refusals:
        for r in refusals:
            print("rm-own: refused " + r, file=sys.stderr)
        return 2
    for real, _ in checked:
        if os.path.isdir(real) and not os.path.islink(real):
            shutil.rmtree(real)
        elif os.path.lexists(real):
            os.remove(real)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
